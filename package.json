{
  "name": "docucore-360",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "storage:cleanup": "tsx scripts/cleanup.ts",
    "postinstall": "node scripts/copy-pdf-assets.mjs && node scripts/copy-ocr-assets.mjs && node scripts/copy-security-assets.mjs",
    "db:local:start": "pg_ctl -D .local-postgres -l .local-postgres/server.log -o \"-h 127.0.0.1 -p 55432\" start",
    "db:local:stop": "pg_ctl -D .local-postgres stop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storage:schedule": "tsx scripts/scheduler.ts",
    "db:deploy": "prisma migrate deploy",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "mail:local:start": "docker compose -p docucore360-local-mail -f deploy/mailpit.local.yaml up -d",
    "mail:local:stop": "docker compose -p docucore360-local-mail -f deploy/mailpit.local.yaml stop",
    "automation:inventory": "node scripts/automation/inventory.mjs",
    "automation:ui": "playwright test -c playwright.automation.config.ts --grep-invert \"@security|@validation\"",
    "automation:api": "playwright test -c playwright.automation.config.ts --grep \"@security|@validation\"",
    "automation:bdd": "cucumber-js",
    "automation:performance": "node scripts/automation/performance.mjs",
    "automation:report": "node scripts/automation/report.mjs",
    "automation:complete": "node scripts/automation/run.mjs",
    "automation:open": "node scripts/automation/serve.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@tesseract.js-data/urd": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fabric": "^7.4.0",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "next": "^16.3.5",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfstudio": "^0.4.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "dotenv": "^18.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}

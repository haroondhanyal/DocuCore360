DATABASE_URL="postgresql://username:password@localhost:5432/docucore360"
APP_URL="http://localhost:3000"
STORAGE_ROOT="./storage"
TEMP_FILE_RETENTION_MINUTES="30"
MAX_UPLOAD_MB="25"
# Optional seed admin; no administrator is created unless both are configured.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Password reset/verification delivery requires SMTP configuration (see docs/DEPLOYMENT.md).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_FROM=""
SMTP_USER=""
SMTP_PASSWORD=""
# Only for a trusted local development mail catcher; keep false in production.
SMTP_ALLOW_INSECURE="false"
